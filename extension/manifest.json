{
   "action": {
      "default_icon": {
         "128": "Icons/128 Sort Feed.png",
         "16": "Icons/16 Sort Feed.png",
         "48": "Icons/48 Sort Feed.png"
      },
      "default_popup": "popup.html"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "css": [ "Animate/animate.css", "Instagram/save/save_button_instagram.css", "shared/sf_banner_primitives.css", "shared/viralspy_overlay.css" ],
      "js": [ "lib/xlsx.full.min.js", "Instagram/content.js", "shared/viralspy_overlay.js" ],
      "matches": [ "https://www.instagram.com/*" ],
      "run_at": "document_start"
   }, {
      "all_frames": true,
      "css": [ "Animate/animate.css", "Tiktok/save/save_button_tiktok.css", "shared/sf_banner_primitives.css", "shared/viralspy_overlay.css" ],
      "js": [ "lib/xlsx.full.min.js", "Tiktok/content.js", "shared/viralspy_overlay.js" ],
      "matches": [ "https://www.tiktok.com/*" ],
      "run_at": "document_start"
   }, {
      "css": [ "shared/sf_banner_primitives.css" ],
      "js": [ "lib/xlsx.full.min.js", "Facebook/content.js" ],
      "matches": [ "https://www.facebook.com/*" ],
      "run_at": "document_start"
   }, {
      "css": [ "Animate/animate.css", "shared/sf_banner_primitives.css" ],
      "js": [ "lib/xlsx.full.min.js", "YouTube/content.js" ],
      "matches": [ "https://www.youtube.com/*" ],
      "run_at": "document_start"
   }, {
      "js": [ "Instagram/script_instagram.js", "Instagram/explore_sort_instagram.js", "Instagram/saved_sort_instagram.js", "Instagram/agent/agent_runner_instagram.js" ],
      "matches": [ "https://www.instagram.com/*" ],
      "run_at": "document_start",
      "world": "MAIN"
   } ],
   "declarative_net_request": {
      "rule_resources": [ {
         "enabled": true,
         "id": "tiktok_interceptor",
         "path": "rules.json"
      } ]
   },
   "description": "ViralSpy — Sort Instagram Reels, Posts, TikTok, Facebook & YouTube by outliers, views or likes. Local MCP + Free Whisper Transcription.",
   "host_permissions": [
      "https://www.instagram.com/*",
      "https://*.cdninstagram.com/*",
      "https://*.fbcdn.net/*",
      "https://www.tiktok.com/*",
      "https://*.tiktokcdn.com/*",
      "https://*.tiktokcdn-us.com/*",
      "https://*.tiktokcdn-eu.com/*",
      "https://www.facebook.com/*",
      "https://www.youtube.com/*",
      "https://*.sortfeed.com/*",
      "http://127.0.0.1/*",
      "http://localhost/*"
   ],
   "icons": {
      "128": "Icons/128 Sort Feed.png",
      "16": "Icons/16 Sort Feed.png",
      "48": "Icons/48 Sort Feed.png"
   },
   "manifest_version": 3,
   "name": "ViralSpy — Sort, Outlier & AI Spy (Instagram, TikTok, YouTube)",
   "permissions": [ "activeTab", "tabs", "declarativeNetRequest", "webNavigation", "storage", "alarms", "scripting" ],
   "short_name": "ViralSpy",
   "version": "21.2",
   "web_accessible_resources": [ {
      "matches": [ "https://www.instagram.com/*", "https://www.tiktok.com/*", "https://www.youtube.com/*", "https://*.sortfeed.com/*" ],
      "resources": [ "Icons/*.png", "Icons/*.svg", "Icons/sf/*.svg", "Icons/BannerIcons/*.png", "Icons/BannerIconNew/*.svg", "Icons/ButtonIcons/*.svg", "Icons/popupIcons/*.svg", "Icons/Hover/*.png", "Icons/ZeroStateIcons/*", "Instagram/script_instagram.js", "Instagram/explore_sort_instagram.js", "Instagram/saved_sort_instagram.js", "Tiktok/script_tiktok.js", "Tiktok/search/search_sort_tiktok.js", "Tiktok/saved/saved_sort_tiktok.js", "Tiktok/similar/similar_fetch_tiktok.js", "YouTube/script_youtube.js" ]
   }, {
      "matches": [ "https://www.facebook.com/*" ],
      "resources": [ "Facebook/script_facebook.js", "Icons/*.png", "Icons/*.svg", "Icons/sf/*.svg", "Icons/BannerIconNew/*.svg", "Icons/BannerIcons/*.png", "Icons/ButtonIcons/*.svg", "Icons/popupIcons/*.svg", "Icons/Hover/*.png", "Icons/ZeroStateIcons/*" ]
   } ]
}
